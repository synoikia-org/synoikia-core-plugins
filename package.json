{
  "name": "synoikia-core-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "synoikia-plugin new",
    "build": "pnpm -r --filter './plugins/*' build",
    "typecheck": "pnpm -r --filter './plugins/*' typecheck",
    "test": "pnpm -r --filter './plugins/*' test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "synoikia-plugin check",
    "workflow": "synoikia-plugin workflow",
    "hooks:install": "synoikia-plugin workflow hooks install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@synoikia/core": "^0.17.2",
    "@synoikia/create-plugin": "^0.6.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "synoikia": {
    "repository": "via-justa/synoikia-core-plugins",
    "name": "Synoikia plugins",
    "workflow": {
      "securityPaths": [
        "plugins/*/manifest.json",
        "plugins/*/plugin.yaml",
        "plugins/*/src/**",
        "plugins/*/test/compliance.yaml",
        "**/package.json",
        ".github/workflows/**",
        "plugins/*/test/fake*.ts",
        "plugins/*/features/**",
        "plugins/*/vitest.config.ts",
        "plugins/*/instructions.md",
        "plugins/*/guides/**",
        "minisign.pub",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        ".claude/**"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "source-map-js": ">=1.2.2"
    }
  }
}
