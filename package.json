{
  "name": "synoikia-core-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "synoikia-plugin new",
    "build": "pnpm -r --filter './plugins/*' build",
    "typecheck": "pnpm -r --filter './plugins/*' typecheck",
    "test": "pnpm -r --filter './plugins/*' test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "synoikia-plugin check",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@novibe-org/gherkin-lint-plus": "1.1.0",
    "@synoikia/core": "^0.17.2",
    "@synoikia/create-plugin": "^0.8.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "madr-lint": "0.4.2",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "synoikia": {
    "repository": "via-justa/synoikia-core-plugins",
    "name": "Synoikia plugins",
    "prose": [
      "*.md",
      "docs/**/*.md",
      "plugins/*/*.md",
      "features/**/*.feature",
      ".claude/**/*.md"
    ]
  },
  "pnpm": {
    "overrides": {
      "source-map-js": ">=1.2.2"
    }
  }
}
